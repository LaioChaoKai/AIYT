# LINE Messaging API 設定
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=9c660cbc99d6f043c7fe28f028c2fcb0

# -------------------------------------------------------------
# AI 模型設定 (選擇方案 A 或 方案 B)
# -------------------------------------------------------------

# 方案 A: Google Gemini API (免費、快速、精準)
# 請自行複製貼上到本檔案中，不需要將金鑰傳給任何人！
GEMINI_API_KEY=your_gemini_api_key_here

# 方案 B: 本地完全開源模型 (Ollama，免 API Key、免聯網保護隱私)
# 開啟方式：將 USE_OLLAMA 改為 true
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5

# 服務埠
PORT=5000
